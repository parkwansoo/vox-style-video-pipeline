# === Vox 스타일 자동 영상 생성 파이프라인 설정 ===
# 이 파일을 .env 로 복사해 값을 채웁니다. .env 는 커밋되지 않습니다.
#
#   cp .env.example .env
#
# 나레이션 TTS: 로컬 clone-voice 백엔드(8930)를 경유합니다. 여기에 키가
#   필요하진 않지만, 백엔드가 Gemini TTS 클라우드로 합성하므로 그 앱에
#   등록된 Google 계정에서 약 $0.03/분이 과금됩니다.
# 이미지: Codex CLI의 ChatGPT 구독 로그인(codex login)을 씁니다 — 키 불필요.

# Google Gemini (https://aistudio.google.com/apikey) — 영상 생성(Omni Flash)용
GEMINI_API_KEY=

# Kie.ai (https://kie.ai/api-key) — 공인(public figure) 클립의 Seedance 2.0 Fast 전용
# 공인이 등장하지 않는 영상만 만들면 비워둬도 됩니다
KIE_API_KEY=

# --- 선택 설정 (기본값 그대로 둬도 됩니다) ---
# Omni Flash 모델 ID
# GEMINI_OMNI_MODEL=gemini-omni-flash-preview
# TTS 음색(Gemini 프리셋 이름)과 톤 프롬프트
# 기본은 Charon 고정. 다른 목소리를 쓰려면 아래 주석을 풀고 이름을 바꾼다.
# Gemini TTS 30종: Zephyr Puck Charon Kore Fenrir Leda Orus Aoede Callirrhoe
#   Autonoe Enceladus Iapetus Umbriel Algieba Despina Erinome Algenib Rasalgethi
#   Laomedeia Achernar Alnilam Schedar Gacrux Pulcherrima Achird Zubenelgenubi
#   Vindemiatrix Sadachbia Sadaltager Sulafat
# 단, clone-voice 백엔드에 프리셋으로 등록된 것만 쓸 수 있다 —
# 실제 목록은 `tts.py --list-voices` 로 확인한다.
# VOX_TTS_VOICE=Charon
# VOX_TTS_TONE=차분하고 신뢰감 있는 40대 한국 남성 다큐멘터리 내레이터, 감정이 풍부함. 웃음소리 등 비언어 소리는 실제로 내지 말고 말투·억양으로만 감정을 표현
# TTS_BASE_URL=http://127.0.0.1:8930
# 나레이션 배속 (다큐 1.0 / 숏폼 1.3). 스타일에 맞춰 조정하거나 tts.py에 --speed로 지정
# VOX_TTS_SPEED=1.0
# Seedance 해상도 (720p가 최대)
KIE_VIDEO_RESOLUTION=720p
# Codex CLI 실행 파일 경로 (기본: PATH의 codex)
# CODEX_BIN=codex
