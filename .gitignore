# 비밀 키
.env

# 실행 산출물 (영상/이미지/음성)
output/

# 사용자 음원 (용량 큼, 개인 파일)
music/*
!music/.gitkeep

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# 사용자 원본 자료 (프로젝트에 복사본 반영됨)
drive-download-*/

# Claude 로컬 설정
.claude/settings.local.json

# 레퍼런스 이미지 — 제3자 콘텐츠라 커밋하지 않는다 (로컬 보관만)
# refs/ = 새 작업 인박스, styles/*/refs/ = 스타일별 보관
refs/*
!refs/.gitkeep
styles/*/refs/*
!styles/*/refs/.gitkeep
